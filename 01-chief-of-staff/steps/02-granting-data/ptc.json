{
  "version": 1,
  "workflow": {
    "components": [
      {
        "id": "chief.workflow",
        "path": "workflow.clj",
        "dependencies": [
          "agent.core"
        ]
      },
      {
        "library": "agent.core"
      }
    ],
    "entry": "chief.workflow/run"
