#!/usr/bin/env bash
#
# Open a REPL over this project's captured runs, with analysis.clj loaded.
#
#   ./analyze              public evidence: runs, turns, timings, outcomes
#   ./analyze --private    adds the PTC-Lisp the model wrote, via (source n)
#
# Anything after the flag is passed through, so this works too:
#
#   ./analyze --private -e '(source -1)'
#   echo '(source -1)' | ./analyze --private -
#
# The private profile reads the inspection artifact, which is off unless the
# project file sets "artifacts": {"inspection": true}.

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

TRACES=.ptc/traces
INSPECTION=.ptc/inspection

if [ ! -d "$TRACES" ]; then
  echo "no captured runs in $TRACES yet; run a chapter first" >&2
  exit 1
fi

PRIVATE=0
if [ "${1:-}" = "--private" ]; then
  PRIVATE=1
  shift
fi

if [ "$PRIVATE" -eq 1 ]; then
  if [ ! -d "$INSPECTION" ]; then
    echo "no inspection artifacts in $INSPECTION." >&2
    echo 'Set "artifacts": {"inspection": true} in the project file and re-run.' >&2
    exit 1
  fi
  # --private-terminal authorizes an interactive session, but rejects --load,
  # --eval, stdin and scripts, so the helpers in analysis.clj cannot be loaded
  # into one. Private queries therefore run one shot with --private-unattended.
  if [ -t 0 ] && [ $# -eq 0 ]; then
    # --private-terminal rejects --load, but not text you type. Put the helpers
    # on the clipboard and open the session; paste at the first prompt.
    if command -v pbcopy >/dev/null 2>&1; then
      pbcopy < analysis.clj
      echo "analysis.clj is on the clipboard. Paste it at the first prompt," >&2
      echo "then use (runs), (turns n) and (source n) as usual." >&2
    else
      echo "Paste the contents of analysis.clj at the first prompt to get the" >&2
      echo "helpers, then use (runs), (turns n) and (source n)." >&2
    fi
    echo >&2
    exec ptc repl \
      --profile private-run-analysis-v1 \
      --resource "traces=$TRACES" \
      --resource "inspection=$INSPECTION" \
      --private-terminal
  fi
  exec ptc repl \
    --profile private-run-analysis-v1 \
    --resource "traces=$TRACES" \
    --resource "inspection=$INSPECTION" \
    --private-unattended \
    -l analysis.clj "$@"
else
  exec ptc repl \
    --profile run-analysis-v1 \
    --resource "traces=$TRACES" \
    -l analysis.clj "$@"
fi
